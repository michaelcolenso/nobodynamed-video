SATORI_URL=http://localhost:3001
D1_URL=https://api.cloudflare.com/client/v4/accounts/<acct>/d1/database/<db>/query
# D1_TOKEN=<scoped token used for D1 and as the Workers AI narration fallback>
OUT_DIR=./out
FONT_DIR=./satori-service/fonts
LATEST_YEAR=2024
LOG_LEVEL=INFO
# Optional Workers AI overrides. By default the account ID is inferred from
# D1_URL and narration uses D1_TOKEN.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
NARRATION_MODEL=@cf/deepgram/aura-2-en
TRANSCRIPTION_MODEL=@cf/openai/whisper-large-v3-turbo
NARRATION_VOICE=luna
NARRATION_ENABLED=true
